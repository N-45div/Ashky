# ==============================================================================
# ASHKY STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Google Agentic Cinema Blockbuster Hackathon (Grafana Labs Partner Track)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=Ashky
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (AGENTIC VIDEO UNDERSTANDING & CINEMA DIRECTION)
# ------------------------------------------------------------------------------
# Your Google AI Studio API key (Leave blank to use zero-config deterministic simulation)
GEMINI_API_KEY=your_gemini_api_key_here

# Latest Gemini Models with Native Agentic Multimodal Video Understanding
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 3. GRAFANA LABS CLOUD & OBSERVABILITY SETTINGS (MCP TRACK)
# ------------------------------------------------------------------------------
# Hosted Grafana Cloud MCP Server Endpoint (Hackathon Requirement)
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp
GRAFANA_STACK_URL=https://your-stack-id.grafana.net

# Grafana Cloud endpoint for real-time telemetry, Prometheus metrics & Loki logs
GRAFANA_CLOUD_URL=https://your-stack-id.grafana.net
GRAFANA_LOKI_URL=https://logs-prod-us-central1.grafana.net
GRAFANA_CLOUD_USER=your_grafana_numeric_user_id
GRAFANA_API_KEY=glc_your_grafana_access_policy_token

# ------------------------------------------------------------------------------
# 4. NETWORK & CORS POLICY
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "*"]
